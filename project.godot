; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Psychodrama"
run/main_scene="uid://xqc1yxn05bn"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]

Bus="*res://autoloads/signal_bus.gd"
Bgm="*res://autoloads/bgm/bgm.tscn"
Vars="*res://autoloads/vars.gd"
NoteValue="*res://addons/SimpleSampler/note_value.gd"
Filters="*res://screen_filters/filters.tscn"
SpellCombos="*res://autoloads/spell_combos.gd"
SceneManager="*res://autoloads/scene_manager.gd"
Find="*res://autoloads/find.gd"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=512
window/size/viewport_height=448
window/size/maximize_disabled=true
window/size/window_width_override=1024
window/size/window_height_override=896
window/stretch/mode="viewport"
window/stretch/aspect="keep_height"
window/stretch/scale_mode="integer"

[editor]

movie_writer/ogv/audio_quality=0.7000000000000001
movie_writer/ogv/encoding_speed=3
movie_writer/movie_file="D:/Documents/godot projects/exports/movie/video.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/SimpleSampler/plugin.cfg", "res://addons/midi/plugin.cfg", "res://addons/midi_import/plugin.cfg")

[global_group]

move_to_cell_indicator=""
beat_vizualizer=""
element_container_ui=""
reticle=""
player=""
player_collision=""
enemy_collision=""
combo_manager=""
main_scene=""
player_spawn=""
obstacle_collision=""
enemy_room_notifier=""
editor_objects=""
level_blueprint=""
forgetter=""
editor_cells=""
dopamine_cluster=""
prep_screen_song_preview=""
layout=""

